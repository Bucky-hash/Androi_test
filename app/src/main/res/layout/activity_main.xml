<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Ô nhập điểm GPA -->
    <EditText
        android:id="@+id/edtGpaInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhập GPA (0.0 - 4.0)"
        android:inputType="numberDecimal"
        android:layout_marginTop="16dp"
        tools:ignore="MissingConstraints" />

    <!-- Nút bấm để kích hoạt Extension -->

    <!-- TextView để hiển thị kết quả xếp loại từ Extension Double -->
    <Button
        android:id="@+id/btnUpdateGpa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cập Nhật Điểm GPA"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="128dp" />

    <TextView
        android:id="@+id/tvGpaBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kết quả xếp loại sẽ hiện ở đây"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="75dp"
        tools:layout_editor_absoluteY="81dp" />
</androidx.constraintlayout.widget.ConstraintLayout>